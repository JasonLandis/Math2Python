# https://www.3blue1brown.com/lessons/derivatives-trig-functions
import sympy as sp

# The examples below showcase the Power Rule. The derivative of x^n is equal to nx^n-1.
# Say you're computing (x + dx)^n, this equates to x^n + nx^n-1dx + many more expressions that contain dx² or greater
# x^n is factored away since that's the initial function and you're just looking at the rate of change, and after you 
# divide by dx, all of the expressions that still contain dx vanish to 0. Therefore, you're left with nx^n-1.

# You can imagine that the function x² represents the area of a square with side lengths x.

# ((x + dx)² - (x²)) / dx
# (x² + 2x(dx) + (dx)² - x²) / dx
# (2x(dx) + (dx)²) / dx
# 2x + dx
# dx is negligible as it is a tiny value
# The derivative of x² is 2x

x, dx = sp.symbols('x dx')

f = x**2 # x²

derivative = sp.diff(f, x)
print("Symbolic derivative of x² computed using sympy:", derivative)

print("\n----------------------------------------------\n")

# You can imagine that the function x³ represents the volume of a square with side lengths x.

# ((x + dx)³ - x³) / dx
# ((x + dx)(x + dx)(x + dx) - x³) / dx
# ((x² + xdx + xdx + dx²)(x + dx) - x³) / dx
# ((x² + 2xdx + dx²)(x + dx) - x³) / dx
# (x³ + x²dx + 2x²dx + 2xdx² + xdx² + dx³ - x³) / dx
# (x³ + 3x²dx + 3xdx² + dx³ - x³) / dx
# (3x²dx + 3xdx² + dx³) / dx
# (3x²dx + 3xdx² + dx³) / dx
# 3x² + 3xdx + dx²
# 3xdx and dx² vanish as dx approaches 0
# The derivative of x³ is 3x²

x, dx = sp.symbols('x dx')

f = x**3 # x³

derivative = sp.diff(f, x)
print("Symbolic derivative of x³ computed using sympy:", derivative)

print("\n----------------------------------------------\n")

# Computing the derivative of 1/x

f = 1/x # 1/x

derivative = sp.diff(f, x)
print("Symbolic derivative of 1/x computed using sympy:", derivative)

print("\n----------------------------------------------\n")

# Computing the derivative of √x

f = sp.sqrt(x) # √x

derivative = sp.diff(f, x)
print("Symbolic derivative of √x computed using sympy:", derivative)

print("\n----------------------------------------------\n")

# Computing the derivative of sin(x) and cos(x)

f1 = sp.sin(x)
f2 = sp.cos(x)

print("Derivative of sin(x):", sp.diff(f1, x))
print("Derivative of cos(x):", sp.diff(f2, x))